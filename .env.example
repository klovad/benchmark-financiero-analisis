# Conexión de SOLO LECTURA al data mart de benchmark-bancos. Copiar a .env (no versionado)
# y completar la contraseña. El rol se crea una vez con sql/admin/rol_lectura.sql del repo
# benchmark-bancos (ver docs/acceso_datos.md).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=benchmark_cartera_depositos
POSTGRES_USER=analista
POSTGRES_PASSWORD=

# Ruta al repo del ETL (para scripts/sincronizar_docs_etl.py). Relativa a este repo.
ETL_REPO=../benchmark-bancos
